    "test": "turbo run test",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "@eslint/js": "^10.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "typescript": "^5.3.0",
    "turbo": "^1.10.0",
    "@types/node": "^20.0.0"
  }
}
